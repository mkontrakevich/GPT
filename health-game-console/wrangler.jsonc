{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "health-game-console-mvp",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}